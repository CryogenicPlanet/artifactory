#!/bin/sh
set -eu
umask 077
# Never unlink this inode. Exec preserves the root PID and its lock through async shutdown.
# This excludes other supported image commands, not uncooperative external SQL clients.
exec /usr/bin/flock --exclusive --nonblock --conflict-exit-code 75 --no-fork /data/.comms-lifetime.lock /opt/comms/deployment/locked-command "$@"
