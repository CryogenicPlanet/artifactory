#!/bin/sh
# Invoked only by entrypoint with the image lifetime flock inherited across exec.
set -eu
umask 002
command=${1:-start}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
  start)
    [ "$#" -eq 0 ] || exit 64
    /usr/local/bin/bun /opt/comms/packages/boot/dist/deployment-layout.js
    entry=/opt/comms/packages/server/dist/main.js
    ;;
  store-transfer)
    entry=/opt/comms/packages/server/dist/store-transfer.js
    ;;
  *) exit 64 ;;
esac
export COMMS_LOCKED_COMMAND="$command"
exec /usr/bin/setpriv --reuid=1000 --regid=1000 --groups=1003 --inh-caps=-all --ambient-caps=-all /usr/local/bin/bun "$entry" "$@"
