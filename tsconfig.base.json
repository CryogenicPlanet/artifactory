{
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2024",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"types": ["bun-types"],
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnostics": false
			}
		]
	}
}
